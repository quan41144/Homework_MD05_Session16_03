<configuration>
    <!-- Thay đổi class sang RollingFileAppender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/app.log</file>
        
        <!-- Cấu hình chính sách cuộn file theo thời gian và dung lượng -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Định dạng tên file khi cuộn (thêm %d cho ngày tháng và %i cho số thứ tự) -->
            <fileNamePattern>logs/app-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            
            <!-- Dung lượng tối đa của một file trước khi bị cắt sang file mới (.0, .1) -->
            <maxFileSize>10MB</maxFileSize>
            
            <!-- Giữ lại tối đa lịch sử log trong 30 ngày, log cũ hơn sẽ bị xóa -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>
</configuration>
